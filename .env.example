# =========================================================================
# CodeQuest Environment Configuration Template
# (Do NOT commit real secret values to version control)
# =========================================================================

# MongoDB Atlas Connection URI
# Required in production Vercel project environment variables
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_domain>/codequest?retryWrites=true&w=majority

# Authentication HMAC-SHA256 Token Signing Secret (64+ character random string)
# Required in production Vercel project environment variables
AUTH_SECRET=your_production_secret_key_change_me_to_a_long_random_string

# Local Express Server Listen Port (optional, defaults to 5000)
PORT=5000

# Allowed CORS origins for standalone backend (optional, comma-separated)
CLIENT_ORIGIN=https://codequest-virid.vercel.app,http://localhost:3000

# Optional API URL override for frontend client (leave unset to use same-origin /api)
# REACT_APP_API_URL=https://codequest-virid.vercel.app/api

# Optional Error Monitoring (e.g., Sentry DSN for backend serverless exceptions)
# SENTRY_DSN=https://<public_key>@<organization>.ingest.sentry.io/<project_id>

# Optional Frontend Telemetry / Analytics toggle (true | false, defaults to true with consent)
# REACT_APP_ANALYTICS_ENABLED=true
